# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Météo (OpenWeatherMap) ────────────────────────────────────
# Créez un compte sur openweathermap.org (plan gratuit suffisant)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Détourage IA (Photoroom) ─────────────────────────────────
# Clé API sur app.photoroom.com
PHOTOROOM_API_KEY=your_photoroom_api_key_here

# ── Sécurité ─────────────────────────────────────────────────
# Générez avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here

# ── Storage Supabase ─────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=garments
