# ╔══════════════════════════════════════════════════════════════╗
# ║                   StyleSync — .env.example                   ║
# ║   Copiez ce fichier en ".env" et remplissez les valeurs      ║
# ║   NE COMMITTEZ JAMAIS LE FICHIER .env DANS GIT !             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Origines CORS autorisées (séparées par des virgules) ─────
# En prod, limitez strictement à vos domaines :
ALLOWED_ORIGINS=https://votre-app.com,https://app.votre-domaine.com

# ── Supabase ─────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Météo (OpenWeatherMap) ────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Détourage IA (Photoroom) ─────────────────────────────────
PHOTOROOM_API_KEY=your_photoroom_api_key_here

# ── Sécurité JWT ─────────────────────────────────────────────
# Générez avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here_minimum_64_chars

# ── Storage Supabase ─────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=garments
